        "            partition_cols=[\"permno\"],\n",
        "            existing_data_behavior=\"delete_matching\"\n",
        "        )\n",
        "\n",
        "    print(f\"Batch {j} of {batches} complete ({100 * j / batches:.1f}%)\")\n",
        "\n",

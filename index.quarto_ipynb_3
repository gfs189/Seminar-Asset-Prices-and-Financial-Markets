      "source": [
        "#| label: compute-bab\n",
        "def bab_month(df):\n",
        "    df = df.copy()\n",
        "    z = df[\"beta\"].rank()\n",
        "    z_bar = z.mean()\n",
        "    centered = z - z_bar\n",
        "    k = 2 / centered.abs().sum()\n",
        "    low_mask = centered < 0\n",
        "    high_mask = centered > 0\n",
        "    low = df[low_mask].copy()\n",
        "    high = df[high_mask].copy()\n",
        "\n",
        "    if low.empty or high.empty:\n",
        "        return pd.Series({\"r_bab\": np.nan, \"beta_L\": np.nan, \"beta_H\": np.nan,\n",
        "                          \"r_L\": np.nan, \"r_H\": np.nan})\n",
        "\n",
        "    low[\"w\"] = (k * (-centered[low_mask])).values\n",
        "    high[\"w\"] = (k * centered[high_mask]).values\n",
        "\n",
        "    beta_L = (low[\"w\"] * low[\"beta\"]).sum()\n",
        "    beta_H = (high[\"w\"] * high[\"beta\"]).sum()\n",
        "    r_L = (low[\"w\"] * low[\"ret_excess\"]).sum()\n",
        "    r_H = (high[\"w\"] * high[\"ret_excess\"]).sum()\n",
        "    r_bab = r_L / beta_L - r_H / beta_H\n",
        "\n",
        "    return pd.Series({\"r_bab\": r_bab, \"beta_L\": beta_L, \"beta_H\": beta_H,\n",
        "                      \"r_L\": r_L, \"r_H\": r_H})\n",

   "source": [
    "#| label: compute-correlation\n",
    "#| echo: false\n",
    "#| output: false\n",
    "\n",
    "# Overlapping 3-day log returns for the market (non-synchronous trading correction)\n",
    "mkt_r3 = (\n",
    "    factors_ff3_daily[[\"date\", \"mkt_excess\"]]\n",
    "    .sort_values(\"date\")\n",
    "    .assign(mkt_r3=lambda x: np.log1p(x[\"mkt_excess\"]).rolling(3, min_periods=3).sum())\n",
    "    [[\"date\", \"mkt_r3\"]]\n",
    "    .dropna(subset=[\"mkt_r3\"])\n",
    ")\n",
    "\n",
    "# Overlapping 3-day log returns per stock\n",
    "crsp_daily_log = (\n",
    "    crsp_daily[[\"permno\", \"date\", \"ret_excess\"]]\n",
    "    .sort_values([\"permno\", \"date\"])\n",
    "    .assign(log_ret=lambda x: np.log1p(x[\"ret_excess\"]))\n",
    ")\n",
    "\n",
    "stock_r3 = (\n",
    "    crsp_daily_log\n",
    "    .set_index(\"date\")\n",
    "    .groupby(\"permno\")[\"log_ret\"]\n",
    "    .rolling(3, min_periods=3)\n",
    "    .sum()\n",
    "    .rename(\"r3\")\n",
    "    .reset_index()\n",
    "    .dropna(subset=[\"r3\"])\n",
    "    .merge(mkt_r3, on=\"date\", how=\"inner\")\n",
    ")\n",
    "\n",
    "# Rolling 1,260-day (5-year) correlation, minimum 750 days (~3 years)\n",
    "def rolling_corr_daily(df, window=CORR_WINDOW, min_periods=CORR_MIN_PERIODS):\n",
    "    df = df.sort_values(\"date\")\n",
    "    rho = df[\"r3\"].rolling(window=window, min_periods=min_periods).corr(df[\"mkt_r3\"])\n",
    "    return df.assign(rho=rho)\n",
    "\n",
    "corr_component = (\n",
    "    stock_r3\n",
    "    .groupby(\"permno\", group_keys=False)\n",
    "    .apply(rolling_corr_daily)\n",
    "    .dropna(subset=[\"rho\"])\n",
    "    .assign(month=lambda x: x[\"date\"].values.astype(\"datetime64[M]\"))\n",
    "    .sort_values([\"permno\", \"date\"])\n",
    "    .groupby([\"permno\", \"month\"])\n",
    "    .last()\n",
    "    .reset_index()\n",
    "    [[\"permno\", \"month\", \"rho\"]]\n",
    ")"

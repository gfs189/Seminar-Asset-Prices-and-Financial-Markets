    "#| label: compute-bab-subperiod\n",
    "def subperiod_stats(r, label):\n",
    "    r = r.dropna()\n",
    "    n = len(r)\n",
    "    ann_mean = r.mean() * 12\n",
    "    ann_std = r.std() * np.sqrt(12)\n",
    "    sharpe = ann_mean / ann_std if ann_std > 0 else np.nan\n",
    "    t = r.mean() / (r.std() / np.sqrt(n)) if n > 1 else np.nan\n",
    "    return pd.Series({\"Period\": label, \"Ann. Mean\": ann_mean,\n",
    "                      \"Ann. Std\": ann_std, \"Sharpe\": sharpe,\n",
    "                      \"t-stat\": t, \"N\": int(n)})\n",
    "\n",
    "bab_ts = bab_returns.dropna(subset=[\"r_bab\"]).copy()\n",
    "bab_ts[\"year\"] = pd.DatetimeIndex(bab_ts[\"month\"]).year\n",
    "\n",
    "period_masks = [\n",
    "    (bab_ts[\"year\"] < 1990, \"1963--1989\"),\n",
    "    ((bab_ts[\"year\"] >= 1990) & (bab_ts[\"year\"] < 2001), \"1990--2000\"),\n",
    "    ((bab_ts[\"year\"] >= 2001) & (bab_ts[\"year\"] < 2010), \"2001--2009\"),\n",
    "    (bab_ts[\"year\"] >= 2010, \"2010--2025\"),\n",
    "]\n",
    "\n",
    "subperiod_df = pd.DataFrame([\n",
    "    subperiod_stats(bab_ts.loc[mask, \"r_bab\"], label)\n",
    "    for mask, label in period_masks\n",
    "]).set_index(\"Period\")"
